DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/transcribe_db
REDIS_URL=redis://localhost:6379/0
TRANSCRIPTION_QUEUE_NAME=transcriptions
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=14400
STORAGE_BACKEND=local
MEDIA_ROOT=./media
WORKER_MEDIA_ACCESS_MODE=shared_storage
WORKER_NAME=transcribe-worker
WORKER_PLATFORM=windows-rtx3070
WORKER_USE_SIMPLE_WORKER=false
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
